# If you prefer committing generated Wails JS bindings, remove `frontend/wailsjs/`.
# They are regenerated by `wails build` / `wails generate module`.

# Build artifacts
/build/
/bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
*.app

# Frontend
frontend/node_modules/
frontend/dist/
frontend/wailsjs/
frontend/package.json.md5
frontend/vitest.config.js.timestamp-*

# Local secrets / encrypted vault (never commit)
vault.enc
master.key
*.tmp
*.enc
.env
.env.*

# Editor / OS / local AI tooling
.vscode/
.idea/
.DS_Store
Thumbs.db
.workbuddy-ai/
.cursor/
*.swp
*~

# Local review notes (not product docs)
CODE_REVIEW*.md
